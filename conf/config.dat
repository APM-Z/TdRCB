#====================================================================
# 1. Input
# One observation file and one navigation file are used.
#====================================================================
# OBS_PATH   RINEX observation file
# NAV_PATH   broadcast ephemeris
# TEMP_PATH  optional temperature file. Leave empty to skip.
OBS_PATH  =..\..\Testdata\day-by-day processing\LONA00AUS_R_20202690000_01D_30S_MO.20o
NAV_PATH  =..\..\Testdata\day-by-day processing\brdc2690.20n
TEMP_PATH =#..\..\Testdata\day-by-day processing\lona_tem_2020269.csv

#====================================================================
# Multi-day
# To switch: set Continue = 1, comment out OBS_PATH and NAV_PATH,
#====================================================================
OBS_DIR   =..\..\Testdata\continuous processing\obs\
NAV_DIR   =..\..\Testdata\continuous processing\nav\

#====================================================================
# 2. Output
#====================================================================
# OUT_PRO    satellite detail (.pro)
# OUT_PATH   RCB solution (.out); also temperature fit (.tfit) and fit residual (.tres)
# OUT_LOG    rejected-satellite log (.log)
# Directory must already exist (program does not create it).
OUT_PRO   =..\..\result\
OUT_PATH  =..\..\result\
OUT_LOG   =..\..\result\

#====================================================================
# 3. Processing
#====================================================================
# Ephopt     0 broadcast ephemeris
# UseBDS     0 BDS-3, 1 BDS-2, 2 BDS-2+BDS-3 (first two freqs: B1I B3I)
# Frequency  number of frequencies
# Elmask     elevation mask (deg)
# Exclsats   excluded PRNs, separated by spaces
# System     bit mask: GPS 1, GLO 4, GAL 8, QZSS 16, BDS 32
# Continue   0 day-by-day, 1 multi-day
Ephopt     =0
UseBDS     =2
Frequency  =2
Elmask     =10
Exclsats   =C01 C02 C03 C04 C05
System     =45
Continue   =0
#====================================================================
# 4. Station
#===================================================================
StaName    =LONA
DOY        =2020269